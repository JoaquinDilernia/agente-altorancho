# Postgres (Railway lo inyecta como DATABASE_URL al linkear el servicio)
DATABASE_URL=postgres://user:pass@localhost:5432/altorancho

# Tienda Nube (app interna de la tienda 2547699)
TIENDANUBE_STORE_ID=2547699
TIENDANUBE_TOKEN=
TIENDANUBE_WEBHOOK_SECRET=

# Meta (system user token con ads_read + ads_management y la cuenta asignada)
META_ACCESS_TOKEN=
META_ACCOUNT_ID=act_XXXXXXXX

# Dashboard
DASHBOARD_PASSWORD=

# Dominio del dashboard (CORS); varios separados por coma
FRONTEND_ORIGIN=https://agente.techdi.com.ar

# Agente de pauta (Claude). El token de Meta además necesita instagram_basic e instagram_manage_insights
# para ver y promocionar los posts de Instagram.
ANTHROPIC_API_KEY=
# Opcionales: la página de Facebook y su Instagram se descubren solos desde la cuenta publicitaria (promote_pages).
# Ojo: NO reusar META_PAGE_ID / META_IG_ACTOR_ID, que eran de la cuenta anterior.
META_ADS_PAGE_ID=
META_ADS_IG_USER_ID=
# Solo para crear un conjunto en una campaña que todavía no tiene ninguno (si no, copia el píxel de sus conjuntos)
META_ADS_PIXEL_ID=
# Link por defecto del botón "Comprar"
STORE_URL=https://altorancho.com
# Modelo del agente (por defecto claude-opus-5-5)
ADS_AGENT_MODEL=

# Token que usa el script de Google Ads para enviar el gasto
GOOGLE_INGEST_TOKEN=
